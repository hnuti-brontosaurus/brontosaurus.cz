{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "custom": true,
      "customGradient": true,
      "palette": [
        { "slug": "primary", "color": "#00a651", "name": "Primární" },
        { "slug": "secondary", "color": "#f0f3f2", "name": "Pozadí" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "delm",
          "fontFamily": "\"Delm\", sans-serif",
          "name": "Delm",
          "fontFace": [
            {
              "fontFamily": "\"Delm\"",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": [ "file:./webfonts/webfont-Delm.woff2" ]
            }
          ]
        },
        {
          "slug": "delm-light",
          "fontFamily": "\"Delm Light\", sans-serif",
          "name": "Delm Light",
          "fontFace": [
            {
              "fontFamily": "\"Delm Light\"",
              "fontWeight": "300",
              "fontStyle": "normal",
              "src": [ "file:./webfonts/webfont-DelmLight.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "1.1rem", "name": "Malé" },
        { "slug": "normal", "size": "1.4rem", "name": "Normální" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "customPadding": true,
      "customUnits": [ "rem" ],
      "spacingSizes": [
        { "slug": "x-small", "size": "0.325rem", "name": "Velmi malé" },
        { "slug": "small", "size": "0.65rem", "name": "Malé" },
        { "slug": "normal", "size": "1.3rem", "name": "Normální" },
        { "slug": "large", "size": "2.6rem", "name": "Velké" },
        { "slug": "x-large", "size": "3.9rem", "name": "Velmi velké" }
      ]
    },
    "layout": {
      "contentSize": "40rem",
      "wideSize": "60rem"
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "\"Delm Light\", sans-serif",
      "fontSize": "var(--wp--preset--font-size--normal)",
      "lineHeight": "1.3"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "\"Delm\", sans-serif",
          "fontWeight": "700"
        }
      },
      "h1": {
        "typography": {
          "textAlign": "center"
        }
      },
      "h2": {
        "typography": {
          "textAlign": "left"
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#fff"
        }
      },
      "core/paragraph": {
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--normal)",
            "right": "var(--wp--preset--spacing--normal)"
          }
        }
      },
      "core/heading": {
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--normal)",
            "right": "var(--wp--preset--spacing--normal)"
          }
        }
      },
      "core/post-title": {
        "typography": {
          "textAlign": "center",
          "fontSize": "3.5rem",
          "fontFamily": "\"Delm\", sans-serif",
          "fontWeight": "700"
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--normal)",
            "right": "var(--wp--preset--spacing--normal)"
          }
        }
      }
    }
  }
}
